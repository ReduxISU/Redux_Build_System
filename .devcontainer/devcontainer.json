{
  "name": "Redux Build System (rbs)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },
  "containerEnv": { "UV_LINK_MODE": "copy" },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin" },
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "postStartCommand": "if [ \"$(stat -c %U /workspaces/Redux_Build_System)\" != \"vscode\" ]; then sudo chown -R vscode:vscode /workspaces/Redux_Build_System; fi",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"]
    }
  }
}
